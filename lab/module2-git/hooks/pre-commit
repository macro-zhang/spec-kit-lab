#!/usr/bin/env bash
# ===========================================================================
# pre-commit  --  "changed src/ but did not touch tests/" guard
# module 2 / git workflow lab
# ===========================================================================
#
# WHERE THIS RUNS AND WHY IT CAN STOP A COMMIT
# -------------------------------------------
# git looks for .git/hooks/pre-commit right before it creates a commit object.
# The hook's exit code IS the decision:
#
#     0   -> git carries on and writes the commit
#     !=0 -> git ABORTS the commit and prints whatever the hook wrote to
#            stderr right there at your terminal. The working tree and the
#            index are left exactly as they were: nothing is lost, no
#            half-made commit is left behind.
#
# That is the whole secret of "a hook can break your commit": not a special
# API, just a non-zero exit code on a script git happens to run.
#
# Limits of this hook are documented in README.md ("three real limits"), the
# short version being: `git commit --no-verify` skips this file completely,
# this file only exists on machines where it was installed, and .git/ is not
# part of the repository so a fresh clone has no hooks at all.
#
# THIN WRAPPER ON PURPOSE
# -----------------------
# All the logic lives in scripts/check_tests_touched.py so that this bash hook
# and hooks/pre-commit.ps1 share exactly one implementation instead of two
# copies that drift apart. This file only:
#   1. finds the repository root,
#   2. finds a Python 3 that actually works,
#   3. runs the checker,
#   4. forwards the checker's exit code untouched.
#
# MANUAL TEST (no commit needed):
#     bash .git/hooks/pre-commit           # decides on the current index
#     bash .git/hooks/pre-commit --json    # payload instead of prose
# ===========================================================================

set -euo pipefail

# --------------------------------------------------------------------------
# 1. repository root
# --------------------------------------------------------------------------
# git runs hooks with cwd at the top level for a normal checkout, but do not
# rely on it: someone will always run this script by hand from a subdirectory.
if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "pre-commit: ERROR: not inside a git work tree" >&2
  exit 1
fi
cd "$repo_root"

# --------------------------------------------------------------------------
# 2. locate the checker
# --------------------------------------------------------------------------
# Search order, first hit wins:
#   1. $TESTS_TOUCHED_CHECKER            explicit override (also used by CI)
#   2. <repo>/.git/hooks/check_tests_touched.py   self-contained install;
#      the demo copies the checker here so the install survives moving the
#      repository away from this lab.
#   3. <repo>/scripts/check_tests_touched.py      checker committed with code
#   4. <repo>/lab/module2-git/scripts/...         this lab's own layout
checker="${TESTS_TOUCHED_CHECKER:-}"
if [ -z "$checker" ]; then
  for candidate in \
    "$repo_root/.git/hooks/check_tests_touched.py" \
    "$repo_root/scripts/check_tests_touched.py" \
    "$repo_root/lab/module2-git/scripts/check_tests_touched.py"
  do
    if [ -f "$candidate" ]; then
      checker="$candidate"
      break
    fi
  done
fi

if [ -z "$checker" ] || [ ! -f "$checker" ]; then
  echo "pre-commit[check-tests-touched]: ERROR: check_tests_touched.py not found" >&2
  echo "pre-commit[check-tests-touched]: ERROR: set TESTS_TOUCHED_CHECKER=<path> or copy it next to this hook" >&2
  # Fail CLOSED. A gate that silently disappears when its tool is missing is
  # worse than a loud one: nobody notices the day it stops protecting them.
  exit 1
fi

# --------------------------------------------------------------------------
# 3. locate a Python 3 that really works
# --------------------------------------------------------------------------
# `command -v python3` is NOT enough on Windows. %LOCALAPPDATA%\Microsoft\
# WindowsApps\python3.exe is a Microsoft Store *app execution alias*: it
# answers `command -v`, and when the Store package is not installed it opens
# the Microsoft Store instead of interpreting your script. Same idea, quieter
# failure: a broken/renamed interpreter that exists but cannot run.
# So every candidate has to prove itself by executing a real Python snippet.
python_argv=()

is_store_alias() {
  case "$(command -v "$1" 2>/dev/null || true)" in
    *Microsoft/WindowsApps*|*Microsoft\\WindowsApps*) return 0 ;;
    *) return 1 ;;
  esac
}

probe_python() {
  # "$@" is a full command line, e.g. ("py" "-3") - verify it is Python 3.
  "$@" -c 'import sys; raise SystemExit(0 if sys.version_info[0] == 3 else 1)' >/dev/null 2>&1
}

if ! is_store_alias python3 && probe_python python3; then
  python_argv=(python3)
elif ! is_store_alias python && probe_python python; then
  python_argv=(python)
elif ! is_store_alias py && probe_python py -3; then
  # The Windows py launcher: `py -3` is a command line, not a single program,
  # which is exactly why python_argv is an array and is expanded as
  # "${python_argv[@]}" everywhere below.
  python_argv=(py -3)
else
  echo "pre-commit[check-tests-touched]: ERROR: no working Python 3 found" >&2
  echo "pre-commit[check-tests-touched]: ERROR: tried: python3, python, py -3" >&2
  echo "pre-commit[check-tests-touched]: ERROR: install Python 3, or skip this hook once with: git commit --no-verify" >&2
  exit 1
fi

# --------------------------------------------------------------------------
# 4. run it and forward the exit code
# --------------------------------------------------------------------------
# `set -e` would already abort on a non-zero status, but forwarding the code
# explicitly documents the contract instead of leaving it to a shell option.
# Do not "improve" this by swallowing the code: the day this hook returns 0 on
# a violation is the day it stops being a gate.
set +e
"${python_argv[@]}" "$checker" "$@"
status=$?
set -e

# Stream discipline: the checker owns stdout (payload only) and writes its own
# ERROR lines to stderr. This hook's own chatter therefore goes to stderr too,
# and stays ASCII so it cannot blow up on a GBK console.
if [ "$status" -eq 0 ] && [ "${TESTS_TOUCHED_QUIET:-0}" != "1" ]; then
  echo "pre-commit[check-tests-touched]: ok" >&2
fi

exit "$status"
